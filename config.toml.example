# Tuning for the SFU. Every key is optional and falls back to the value shown here,
# so a partial file is fine. Copy to config.toml and change only what you need.
# Deleting the file entirely runs on defaults.

# Link quality of a viewer, judged over a sliding window of its perf reports.
# Gates relay promotion and triggers demotion.
[perf]
# How long a report stays in the window.
window_max_age_secs = 300
# Hard cap on window length, so a chatty client cannot grow it without bound.
window_max_len = 1000
# A viewer is healthy while its windowed averages stay under both cutoffs.
rtt_ms_cutoff = 30
loss_pct_cutoff = 10.0
# Reports required before the window is trusted at all.
min_samples_len = 200

# Promotion and demotion of viewers acting as P2P relays.
# See docs/decisions/0009-auto-promote-demote-policy.md.
[relay]
# A requested upload probe that goes unanswered this long is marked failed.
probe_timeout_secs = 60
# Backoff before probing the same viewer again after a failure.
probe_interval_secs = 120
# How long a viewer must stay connected before it is considered stable.
min_connection_age_secs = 300
# Probed upload a candidate must clear to be promoted.
available_upload_cutoff_kbps = 13000
# Measured outbound rate a relay must sustain, or it is demoted.
outgoing_cutoff_kbps = 7000

# Bandwidth estimation and simulcast layer selection for viewers.
[bitrate]
# Starting estimate before TWCC has data, and the ceiling the server asks for.
initial_mbps = 4
desired_mbps = 10
# Slack kept below the estimate so a layer is not run right at the limit.
headroom_margin_percent = 10
# Extra margin required before switching up, which keeps layers from flapping.
upswitch_margin_percent = 10
# Measurement window for the per layer bitrate estimator. Shorter reacts faster
# and is noisier.
estimate_secs = 3
